# REQUIRED on production: URL of the domain you really own. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://YOUR-OWN-DOMAIN.example

# Optional: verified team email for mailto forms. No email is invented in the demo.
NEXT_PUBLIC_CONTACT_EMAIL=

# Fail-closed Donation QR Integrity Protection
# Set to 'true' to enable the verified donation endpoint
DONATION_ENABLED=false
# Base64-encoded SPKI DER Ed25519 public key (generated offline via scripts/generate-donation-key.mjs)
DONATION_VERIFY_PUBLIC_KEY_B64=
