# REQUIRED on production: URL of the domain you really own. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://YOUR-OWN-DOMAIN.example

# Optional: verified team email for mailto forms. No email is invented in the demo.
NEXT_PUBLIC_CONTACT_EMAIL=

# Fail-closed Donation QR Integrity Protection
# Keep 'false' until real bank account, recipient name, and QR image are verified offline.
DONATION_ENABLED=false
# Base64-encoded SPKI DER Ed25519 public key (generated offline via scripts/generate-donation-key.mjs)
DONATION_VERIFY_PUBLIC_KEY_B64=

# Content Security Policy Mode:
# - 'nonce' (default, Stage B): dynamic per-request cryptographic nonce without 'unsafe-inline' in script-src
# - 'stage-a': transitional CSP with script-src 'self' 'unsafe-inline' (no 'unsafe-eval' in production)
CSP_MODE=nonce
# Set to 'true' on staging to emit Content-Security-Policy-Report-Only header alongside testing
CSP_REPORT_ONLY=false

